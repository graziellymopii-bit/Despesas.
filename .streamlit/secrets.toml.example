# ou cole o conteúdo em Settings → Secrets no Streamlit Cloud.
# Use a chave PÚBLICA (publishable / anon). Nunca use a "secret" / "service_role".

[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "COLE-AQUI-A-CHAVE-PUBLISHABLE-OU-ANON"
